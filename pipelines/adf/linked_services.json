{
  "linkedServices": [
    {
      "name": "ls_adls_healthcare",
      "properties": {
        "type": "AzureBlobFS",
        "description": "Azure Data Lake Storage Gen2 — Healthcare Platform",
        "typeProperties": {
          "url": "https://@{linkedService().storageAccount}.dfs.core.windows.net",
          "accountKey": {
            "type": "AzureKeyVaultSecret",
            "store": { "referenceName": "ls_keyvault", "type": "LinkedServiceReference" },
            "secretName": "storage-account-key"
          }
        },
        "connectVia": {
          "referenceName": "AutoResolveIntegrationRuntime",
          "type": "IntegrationRuntimeReference"
        },
        "parameters": {
          "storageAccount": { "type": "string" }
        }
      }
    },
    {
      "name": "ls_databricks",
      "properties": {
        "type": "AzureDatabricks",
        "description": "Azure Databricks — Healthcare workspace",
        "typeProperties": {
          "domain": "https://adb-WORKSPACE_ID.azuredatabricks.net",
          "authentication": "MSI",
          "existingClusterId": "",
          "newClusterNodeType": "Standard_D8s_v3",
          "newClusterNumOfWorker": "2:8",
          "newClusterSparkEnvVars": {
            "PYSPARK_PYTHON": "/databricks/python3/bin/python3"
          },
          "newClusterInitScripts": [],
          "clusterOption": "Fixed",
          "newClusterVersion": "14.3.x-scala2.12"
        },
        "connectVia": {
          "referenceName": "AutoResolveIntegrationRuntime",
          "type": "IntegrationRuntimeReference"
        }
      }
    },
    {
      "name": "ls_keyvault",
      "properties": {
        "type": "AzureKeyVault",
        "description": "Azure Key Vault — Secrets store",
        "typeProperties": {
          "baseUrl": "https://kv-healthcare-@{linkedService().environment}.vault.azure.net/"
        },
        "parameters": {
          "environment": { "type": "string", "defaultValue": "dev" }
        }
      }
    }
  ],
  "datasets": [
    {
      "name": "ds_adls_csv_source",
      "properties": {
        "type": "DelimitedText",
        "linkedServiceName": {
          "referenceName": "ls_adls_healthcare",
          "type": "LinkedServiceReference"
        },
        "parameters": {
          "container": { "type": "string" },
          "fileName":  { "type": "string" }
        },
        "typeProperties": {
          "location": {
            "type": "AzureBlobFSLocation",
            "fileName": "@dataset().fileName",
            "fileSystem": "@dataset().container"
          },
          "columnDelimiter": ",",
          "escapeChar": "\\",
          "firstRowAsHeader": true,
          "quoteChar": "\""
        }
      }
    },
    {
      "name": "ds_adls_parquet_sink",
      "properties": {
        "type": "Parquet",
        "linkedServiceName": {
          "referenceName": "ls_adls_healthcare",
          "type": "LinkedServiceReference"
        },
        "parameters": {
          "container": { "type": "string" },
          "folder":    { "type": "string" }
        },
        "typeProperties": {
          "location": {
            "type": "AzureBlobFSLocation",
            "folderPath": "@dataset().folder",
            "fileSystem": "@dataset().container"
          },
          "compressionCodec": "snappy"
        }
      }
    }
  ]
}
